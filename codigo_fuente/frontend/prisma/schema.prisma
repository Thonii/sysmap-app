// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String?
  sourcePlatform  String   @map("source_platform")
  sourceId        String   @map("source_id")
  sourceUrl       String?  @map("source_url")
  startTime       DateTime @map("start_time")
  endTime         DateTime? @map("end_time")
  venueName       String?  @map("venue_name")
  address         String?
  latitude        Float?
  longitude       Float?
  city            String
  tags            String   @default("[]") // Almacena como string JSON en SQLite
  rawData         String?  @map("raw_data") // Almacena como string JSON en SQLite
  isTech          Boolean  @default(true) @map("is_tech")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([sourcePlatform, sourceId], name: "unique_source_event")
  @@map("eventos")
}

model Subscription {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?
  preferenceChannel String   @default("email") @map("preference_channel")
  city              String   @default("Buenos Aires")
  latitude          Float?
  longitude         Float?
  radiusKm          Float    @default(15.0) @map("radius_km")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("suscripciones")
}

model IACache {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // Almacena como string JSON en SQLite
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cache_ia")
}

// Modelos para NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreference?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  tags      String   @default("[]") // Tags de interés del boletín en string JSON
  radiusKm  Float    @default(15.0) @map("radius_km")
  latitude  Float?
  longitude Float?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
